# Ejemplo. Copiar como backend/.env y reemplazar. No subir backend/.env al repositorio.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://biocore:replace-password@localhost:5432/biocore
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Tokens (PRD: access 15 min, refresh 7 días)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# lax | strict | none (usar none solo si el frontend está en otro dominio y con HTTPS)
COOKIE_SAMESITE=lax

# Bloqueo por intentos fallidos
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=30
PASSWORD_RESET_EXPIRE_MINUTES=60

# Cifrado en reposo (2FA y, más adelante, certificados .p12 y API keys DTE)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Frontend (enlaces de los correos) y orígenes CORS separados por coma
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Correo saliente (sin SMTP_HOST, en desarrollo los correos se muestran en el log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# SuperAdmin inicial: se crea con `python -m app.cli crear-superadmin` solo si no existe ninguno
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
